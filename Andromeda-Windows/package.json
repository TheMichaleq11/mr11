{
  "name": "andromeda-windows",
  "productName": "Andromeda",
  "version": "1.0.3",
  "description": "Andromeda — czytelny USOS UJ na Windowsa",
  "author": "Michał Rosiek",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "pl.andromeda.app",
    "productName": "Andromeda",
    "copyright": "© 2026 Michał Rosiek",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.ico",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Andromeda",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Andromeda",
      "artifactName": "Andromeda-Setup-${version}.exe"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "koffi": "^3.3.5"
  }
}
